<!DOCTYPE html>
<html lang="zh-TW">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>週薪計算器 / Weekly Pay Calculator</title>
<link href="https://fonts.googleapis.com/css2?family=Noto+Sans+TC:wght@300;400;500;700&family=DM+Mono:wght@400;500&display=swap" rel="stylesheet">
<style>

/* =====================
   VARIABLES & RESET
   ===================== */
:root {
  --bg:        #0f0f11;
  --surface:   #18181c;
  --surface2:  #222228;
  --border:    #2e2e38;
  --accent:    #7ee8a2;
  --accent2:   #38bdf8;
  --warn:      #fb923c;
  --text:      #e8e8f0;
  --muted:     #6b6b80;
  --radius:    12px;
  --font-body: 'Noto Sans TC', sans-serif;
  --font-mono: 'DM Mono', monospace;
}

*, *::before, *::after {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

/* =====================
   BASE
   ===================== */
body {
  background-color: var(--bg);
  color: var(--text);
  font-family: var(--font-body);
  min-height: 100vh;
  padding: 32px 16px 64px;
}

body::before {
  content: '';
  position: fixed;
  inset: 0;
  background-image:
    linear-gradient(rgba(126,232,162,0.03) 1px, transparent 1px),
    linear-gradient(90deg, rgba(126,232,162,0.03) 1px, transparent 1px);
  background-size: 40px 40px;
  pointer-events: none;
  z-index: 0;
}

/* =====================
   LAYOUT
   ===================== */
.wrap {
  max-width: 720px;
  margin: 0 auto;
  position: relative;
  z-index: 1;
}

/* =====================
   HEADER
   ===================== */
.page-header {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 16px;
  flex-wrap: wrap;
  margin-bottom: 36px;
}

.title-block h1 {
  font-size: clamp(22px, 5vw, 32px);
  font-weight: 700;
  letter-spacing: -0.5px;
  line-height: 1.1;
}

.title-highlight {
  color: var(--accent);
}

.title-sub {
  color: var(--muted);
  font-size: 13px;
  margin-top: 6px;
  font-weight: 300;
}

/* =====================
   HEADER CONTROLS
   ===================== */
.header-controls {
  display: flex;
  align-items: center;
  gap: 10px;
  flex-wrap: wrap;
}

.lang-toggle {
  display: flex;
  background-color: var(--surface);
  border: 1px solid var(--border);
  border-radius: 100px;
  overflow: hidden;
}

.lang-btn {
  background: transparent;
  border: none;
  color: var(--muted);
  font-family: var(--font-mono);
  font-size: 12px;
  padding: 6px 14px;
  cursor: pointer;
  transition: background-color 0.2s, color 0.2s;
}

.lang-btn.is-active {
  background-color: var(--accent);
  color: #0f1a14;
  font-weight: 500;
}

.week-nav {
  display: flex;
  align-items: center;
  gap: 8px;
}

.week-nav-btn {
  background-color: var(--surface);
  border: 1px solid var(--border);
  color: var(--muted);
  font-size: 16px;
  padding: 6px 12px;
  border-radius: 6px;
  cursor: pointer;
  transition: color 0.2s, border-color 0.2s;
  font-family: var(--font-body);
}

.week-nav-btn:hover {
  color: var(--text);
  border-color: var(--text);
}

.week-label {
  font-family: var(--font-mono);
  font-size: 13px;
  color: var(--muted);
  min-width: 160px;
  text-align: center;
}

/* =====================
   SECTION DIVIDER
   ===================== */
.section-divider {
  display: flex;
  align-items: center;
  gap: 10px;
  font-size: 11px;
  letter-spacing: 2px;
  text-transform: uppercase;
  color: var(--muted);
  margin-bottom: 12px;
}

.section-divider::after {
  content: '';
  flex: 1;
  height: 1px;
  background-color: var(--border);
}

/* =====================
   SETTINGS CARD
   ===================== */
.settings-card {
  background-color: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  padding: 24px;
  margin-bottom: 24px;
  position: relative;
  overflow: hidden;
}

.settings-card::before {
  content: 'SETTINGS';
  position: absolute;
  top: 16px;
  right: 16px;
  font-family: var(--font-mono);
  font-size: 10px;
  color: var(--border);
  letter-spacing: 2px;
}

.settings-grid {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr;
  gap: 16px;
}

.settings-grid--two {
  grid-template-columns: 1fr 1fr;
}

/* =====================
   FORM FIELDS
   ===================== */
.field label {
  display: block;
  font-size: 11px;
  color: var(--muted);
  letter-spacing: 1px;
  text-transform: uppercase;
  margin-bottom: 8px;
  font-weight: 500;
}

.field input {
  width: 100%;
  background-color: var(--surface2);
  border: 1px solid var(--border);
  border-radius: 8px;
  color: var(--text);
  font-size: 15px;
  font-family: var(--font-mono);
  padding: 10px 12px;
  transition: border-color 0.2s, box-shadow 0.2s;
  outline: none;
}

.field input:focus {
  border-color: var(--accent);
  box-shadow: 0 0 0 3px rgba(126,232,162,0.08);
}

input[type="number"]::-webkit-inner-spin-button,
input[type="number"]::-webkit-outer-spin-button {
  -webkit-appearance: none;
}
input[type="number"] {
  -moz-appearance: textfield;
}

/* =====================
   DAY ROWS
   ===================== */
.days-container {
  display: flex;
  flex-direction: column;
  gap: 8px;
  margin-bottom: 24px;
}

.day-row {
  background-color: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  padding: 16px 20px;
  display: grid;
  grid-template-columns: 90px 1fr 110px 110px;
  gap: 12px;
  align-items: center;
  transition: border-color 0.2s, transform 0.15s;
}

.day-row:hover {
  border-color: rgba(126,232,162,0.3);
  transform: translateX(2px);
}

.day-name {
  font-weight: 500;
  font-size: 14px;
  display: flex;
  flex-direction: column;
  gap: 2px;
}

.day-date {
  font-size: 11px;
  color: var(--muted);
  font-family: var(--font-mono);
}

.day-input {
  background-color: var(--surface2);
  border: 1px solid var(--border);
  border-radius: 8px;
  color: var(--text);
  font-family: var(--font-mono);
  font-size: 14px;
  padding: 8px 12px;
  outline: none;
  width: 100%;
  transition: border-color 0.2s, box-shadow 0.2s;
}

.day-input:focus {
  border-color: var(--accent2);
  box-shadow: 0 0 0 3px rgba(56,189,248,0.08);
}

.day-commission {
  font-family: var(--font-mono);
  font-size: 13px;
  color: var(--muted);
  text-align: right;
}

.day-commission.is-commission {
  color: var(--accent2);
}

.day-earning {
  font-family: var(--font-mono);
  font-size: 14px;
  font-weight: 500;
  text-align: right;
  color: var(--muted);
}

.day-earning.is-commission {
  color: var(--accent);
}

.day-earning.is-base {
  color: var(--accent2);
}

/* =====================
   RESULT CARD
   ===================== */
.result-card {
  background-color: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  padding: 28px 24px;
  position: relative;
  overflow: hidden;
}

.result-card::after {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 2px;
  background: linear-gradient(90deg, var(--accent), var(--accent2));
}

.result-grid {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr;
  gap: 20px;
  margin-bottom: 24px;
}

.stat {
  display: flex;
  flex-direction: column;
  gap: 6px;
}

.stat-label {
  font-size: 11px;
  color: var(--muted);
  letter-spacing: 1px;
  text-transform: uppercase;
}

.stat-value {
  font-family: var(--font-mono);
  font-size: 20px;
  font-weight: 500;
}

.stat.is-highlight .stat-value {
  color: var(--accent);
  font-size: 26px;
}

.result-divider {
  height: 1px;
  background-color: var(--border);
  margin: 20px 0;
}

/* =====================
   WAGE MODE ROW
   ===================== */
.wage-mode-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 12px;
}

.wage-mode-left {
  display: flex;
  align-items: center;
  gap: 10px;
}

.wage-mode-label {
  font-size: 13px;
  color: var(--muted);
}

.mode-badge {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 5px 12px;
  border-radius: 100px;
  font-size: 12px;
  font-weight: 500;
  font-family: var(--font-mono);
}

.mode-badge::before {
  content: '●';
  font-size: 8px;
}

.mode-badge.is-commission {
  background-color: rgba(126,232,162,0.12);
  color: var(--accent);
  border: 1px solid rgba(126,232,162,0.3);
}

.mode-badge.is-base {
  background-color: rgba(56,189,248,0.12);
  color: var(--accent2);
  border: 1px solid rgba(56,189,248,0.3);
}

.calc-hint {
  font-size: 12px;
  color: var(--muted);
  font-family: var(--font-mono);
}

/* =====================
   TIP BOX
   ===================== */
.tip-box {
  display: none;
  background-color: rgba(251,146,60,0.06);
  border: 1px solid rgba(251,146,60,0.2);
  border-radius: 8px;
  padding: 12px 16px;
  font-size: 12px;
  color: var(--warn);
  margin-top: 16px;
}

.tip-box.is-visible {
  display: block;
}

/* =====================
   ACTIONS
   ===================== */
.action-row {
  display: flex;
  gap: 10px;
  margin-top: 24px;
  flex-wrap: wrap;
}

.btn {
  padding: 10px 20px;
  border-radius: 8px;
  font-size: 13px;
  font-weight: 500;
  cursor: pointer;
  border: none;
  font-family: var(--font-body);
  letter-spacing: 0.3px;
  transition: background-color 0.15s, color 0.15s, border-color 0.15s, transform 0.15s;
}

.btn-primary {
  background-color: var(--accent);
  color: #0f1a14;
}

.btn-primary:hover {
  background-color: #9ef5bc;
  transform: translateY(-1px);
}

.btn-ghost {
  background-color: transparent;
  border: 1px solid var(--border);
  color: var(--muted);
}

.btn-ghost:hover {
  border-color: var(--text);
  color: var(--text);
}

/* =====================
   RESPONSIVE
   ===================== */
@media (max-width: 560px) {
  .settings-grid {
    grid-template-columns: 1fr 1fr;
  }

  .day-row {
    grid-template-columns: 1fr 1fr;
  }

  .day-name {
    grid-column: 1;
  }

  .day-commission {
    grid-column: 2;
    align-self: center;
  }

  .day-input {
    grid-column: 1 / -1;
  }

  .day-earning {
    grid-column: 1 / -1;
    text-align: left;
  }

  .result-grid {
    grid-template-columns: 1fr 1fr;
  }
}

</style>
</head>
<body>

<div class="wrap">

  <header class="page-header">
    <div class="title-block">
      <h1>週薪<span class="title-highlight" id="h1-second">計算器</span></h1>
      <p class="title-sub" id="title-sub">業績抽成 · 澳幣 AUD · 每週記錄</p>
    </div>

    <div class="header-controls">
      <div class="lang-toggle">
        <button class="lang-btn is-active" id="btnZh" onclick="setLang('zh')">中文</button>
        <button class="lang-btn" id="btnEn" onclick="setLang('en')">EN</button>
      </div>

      <nav class="week-nav">
        <button class="week-nav-btn" onclick="changeWeek(-1)">‹</button>
        <span class="week-label" id="weekLabel">—</span>
        <button class="week-nav-btn" onclick="changeWeek(1)">›</button>
      </nav>
    </div>
  </header>

  <!-- SETTINGS -->
  <div class="settings-card">
    <div class="settings-grid settings-grid--two">
      <div class="field">
        <label id="lbl-base">底薪（每天）</label>
        <input type="number" id="baseSalary" value="100" step="0.01" oninput="recalc()">
      </div>
      <div class="field">
        <label id="lbl-rate">抽成比例 %</label>
        <input type="number" id="commissionRate" value="40" step="0.1" oninput="recalc()">
      </div>
    </div>
  </div>

  <!-- DAILY -->
  <div class="section-divider" id="lbl-daily">每日業績</div>
  <div class="days-container" id="daysContainer"></div>

  <!-- SUMMARY -->
  <div class="section-divider" id="lbl-summary">本週小結</div>

  <div class="result-card">
    <div class="result-grid">
      <div class="stat">
        <div class="stat-label" id="lbl-totalRev">總業績</div>
        <div class="stat-value" id="totalRevenue">A$0.00</div>
      </div>
      <div class="stat">
        <div class="stat-label" id="lbl-totalComm">總抽成</div>
        <div class="stat-value" id="totalCommission">A$0.00</div>
      </div>
      <div class="stat is-highlight">
        <div class="stat-label" id="lbl-finalPay">實領薪資</div>
        <div class="stat-value" id="finalPay">A$0.00</div>
      </div>
    </div>

    <div class="result-divider"></div>

    <div class="wage-mode-row">
      <div class="wage-mode-left">
        <span class="wage-mode-label" id="lbl-wageMode">計薪方式：</span>
        <span class="mode-badge is-base" id="modeBadge">—</span>
      </div>
      <span class="calc-hint" id="calcHint"></span>
    </div>

    <div class="tip-box" id="tipBox"></div>

    <div class="action-row">
      <button class="btn btn-primary" id="btnCopy" onclick="copyResult()">複製結果</button>
      <button class="btn btn-ghost" id="btnClear" onclick="clearWeek()">清除本週</button>
      <button class="btn btn-ghost" id="btnPrint" onclick="window.print()">列印</button>
    </div>
  </div>

</div>

<script>

/* =====================
   STRINGS
   ===================== */
var STRINGS = {
  zh: {
    h1second:    '計算器',
    titleSub:    '業績抽成 · 澳幣 AUD · 每週記錄',
    lblBase:     '底薪（每天）',
    lblRate:     '抽成比例 %',
    lblDaily:    '每日業績',
    lblSummary:  '本週小結',
    lblTotalRev: '總業績',
    lblTotalComm:'總抽成',
    lblFinalPay: '實領薪資',
    lblWageMode: '計薪方式：',
    btnCopy:     '複製結果',
    btnClear:    '清除本週',
    btnPrint:    '列印',
    days:        ['週一','週二','週三','週四','週五','週六','週日'],
    placeholder: '業績金額',
    noData:      '尚未輸入',
    commission:  '抽成制為主',
    base:        '底薪制為主',
    hintDaily:   function(b,rate){ return '每天底薪 '+b+'，業績 × '+rate+'% 超過底薪則用抽成'; },
    copyHeader:  '📊 週薪計算紀錄',
    copyPeriod:  function(s,e){ return '週期：'+s+' – '+e; },
    copySettings:function(b,r){ return '每日底薪：A$'+b+' ／ 抽成：'+r+'%'; },
    copyRow:     function(d,dt,r,c,pay){ return d+' '+dt+'：業績 '+r+' → 抽成 '+c+' → 實領 '+pay; },
    copyTotal:   function(r){ return '總業績：'+r; },
    copyComm:    function(c){ return '總抽成：'+c; },
    copyFinal:   function(f){ return '✅ 實領薪資：'+f; },
    copied:      '✓ 已複製',
    confirmClear:'確定要清除本週所有業績資料？',
  },
  en: {
    h1second:    'Calculator',
    titleSub:    'Commission · AUD · Weekly Record',
    lblBase:     'Base Pay (Daily)',
    lblRate:     'Commission %',
    lblDaily:    'Daily Revenue',
    lblSummary:  'Weekly Summary',
    lblTotalRev: 'Total Revenue',
    lblTotalComm:'Total Commission',
    lblFinalPay: 'Final Pay',
    lblWageMode: 'Pay Mode:',
    btnCopy:     'Copy Result',
    btnClear:    'Clear Week',
    btnPrint:    'Print',
    days:        ['Mon','Tue','Wed','Thu','Fri','Sat','Sun'],
    placeholder: 'Revenue',
    noData:      'No data yet',
    commission:  'Mostly Commission',
    base:        'Mostly Base Pay',
    hintDaily:   function(b,rate){ return 'Daily base '+b+', commission (×'+rate+'%) wins if higher'; },
    copyHeader:  '📊 Weekly Pay Record',
    copyPeriod:  function(s,e){ return 'Period: '+s+' – '+e; },
    copySettings:function(b,r){ return 'Daily Base: A$'+b+' / Commission: '+r+'%'; },
    copyRow:     function(d,dt,r,c,pay){ return d+' '+dt+': Revenue '+r+' → Commission '+c+' → Pay '+pay; },
    copyTotal:   function(r){ return 'Total Revenue: '+r; },
    copyComm:    function(c){ return 'Total Commission: '+c; },
    copyFinal:   function(f){ return '✅ Final Pay: '+f; },
    copied:      '✓ Copied',
    confirmClear:'Clear all revenue data for this week?',
  }
};

/* =====================
   STATE
   ===================== */
var lang = localStorage.getItem('salary_lang') || 'zh';
var weekOffset = 0;

/* =====================
   LANGUAGE SWITCH
   ===================== */
function setLang(l) {
  lang = l;
  localStorage.setItem('salary_lang', l);
  document.getElementById('btnZh').classList.toggle('is-active', l === 'zh');
  document.getElementById('btnEn').classList.toggle('is-active', l === 'en');
  applyStrings();
  buildDayRows();
  loadData();
}

function applyStrings() {
  var s = STRINGS[lang];
  document.getElementById('h1-second').textContent    = s.h1second;
  document.getElementById('title-sub').textContent    = s.titleSub;
  document.getElementById('lbl-base').textContent     = s.lblBase;
  document.getElementById('lbl-rate').textContent     = s.lblRate;
  document.getElementById('lbl-daily').textContent    = s.lblDaily;
  document.getElementById('lbl-summary').textContent  = s.lblSummary;
  document.getElementById('lbl-totalRev').textContent = s.lblTotalRev;
  document.getElementById('lbl-totalComm').textContent= s.lblTotalComm;
  document.getElementById('lbl-finalPay').textContent = s.lblFinalPay;
  document.getElementById('lbl-wageMode').textContent = s.lblWageMode;
  document.getElementById('btnCopy').textContent      = s.btnCopy;
  document.getElementById('btnClear').textContent     = s.btnClear;
  document.getElementById('btnPrint').textContent     = s.btnPrint;
}

/* =====================
   WEEK
   ===================== */
function getWeekStart(offset) {
  var now = new Date();
  var dow = now.getDay();
  var diffToMon = dow === 0 ? -6 : 1 - dow;
  var mon = new Date(now);
  mon.setDate(now.getDate() + diffToMon + (offset || 0) * 7);
  mon.setHours(0, 0, 0, 0);
  return mon;
}

function formatDate(d) {
  return (d.getMonth() + 1) + '/' + d.getDate();
}

function getWeekKey(offset) {
  var start = getWeekStart(offset);
  return 'week_' + start.toISOString().slice(0, 10);
}

function updateWeekLabel() {
  var start = getWeekStart(weekOffset);
  var end = new Date(start);
  end.setDate(start.getDate() + 6);
  document.getElementById('weekLabel').textContent =
    start.getFullYear() + ' ' + formatDate(start) + ' – ' + formatDate(end);
}

function changeWeek(dir) {
  weekOffset += dir;
  updateWeekLabel();
  buildDayRows();
  loadData();
}

/* =====================
   BUILD ROWS
   ===================== */
function buildDayRows() {
  var container = document.getElementById('daysContainer');
  container.innerHTML = '';
  var start = getWeekStart(weekOffset);
  var s = STRINGS[lang];

  for (var i = 0; i < 7; i++) {
    var date = new Date(start);
    date.setDate(start.getDate() + i);

    var row = document.createElement('div');
    row.className = 'day-row';
    row.id = 'row-' + i;

    var nameDiv = document.createElement('div');
    nameDiv.className = 'day-name';

    var nameText = document.createTextNode(s.days[i]);
    var dateSpan = document.createElement('span');
    dateSpan.className = 'day-date';
    dateSpan.textContent = formatDate(date);
    nameDiv.appendChild(nameText);
    nameDiv.appendChild(dateSpan);

    var input = document.createElement('input');
    input.type = 'number';
    input.id = 'revenue-' + i;
    input.className = 'day-input';
    input.placeholder = s.placeholder;
    input.min = '0';
    input.step = '0.01';
    input.addEventListener('input', function() { recalc(); saveData(); });

    var commDiv = document.createElement('div');
    commDiv.className = 'day-commission';
    commDiv.id = 'comm-' + i;
    commDiv.textContent = '—';

    var earnDiv = document.createElement('div');
    earnDiv.className = 'day-earning';
    earnDiv.id = 'earn-' + i;
    earnDiv.textContent = '—';

    row.appendChild(nameDiv);
    row.appendChild(input);
    row.appendChild(commDiv);
    row.appendChild(earnDiv);
    container.appendChild(row);
  }
}

/* =====================
   FORMAT
   ===================== */
function fmt(n) {
  return 'A$' + n.toLocaleString('en-AU', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
}

/* =====================
   RECALC
   ===================== */
function recalc() {
  var dailyBase = parseFloat(document.getElementById('baseSalary').value) || 0;
  var rate      = parseFloat(document.getElementById('commissionRate').value) || 0;
  var s         = STRINGS[lang];
  var totalRev      = 0;
  var totalComm     = 0;
  var totalFinalPay = 0;
  var daysWorked    = 0;

  for (var i = 0; i < 7; i++) {
    var inputEl = document.getElementById('revenue-' + i);
    if (!inputEl) continue;
    var rev  = parseFloat(inputEl.value) || 0;
    var comm = rev * rate / 100;

    // Per-day logic: use commission if it exceeds daily base, else use daily base
    var dayPay = 0;
    var modeEl = document.getElementById('earn-' + i);
    var commEl = document.getElementById('comm-' + i);

    if (rev > 0) {
      daysWorked++;
      totalRev  += rev;
      totalComm += comm;

      if (comm > dailyBase) {
        dayPay = comm;
        commEl.textContent = fmt(comm);
        commEl.className   = 'day-commission is-commission';
        modeEl.textContent = fmt(comm);
        modeEl.className   = 'day-earning is-commission';
      } else {
        dayPay = dailyBase;
        commEl.textContent = fmt(comm);
        commEl.className   = 'day-commission';
        modeEl.textContent = fmt(dailyBase);
        modeEl.className   = 'day-earning is-base';
      }
    } else {
      commEl.textContent = '—';
      commEl.className   = 'day-commission';
      modeEl.textContent = '—';
      modeEl.className   = 'day-earning';
    }

    totalFinalPay += dayPay;
  }

  document.getElementById('totalRevenue').textContent    = fmt(totalRev);
  document.getElementById('totalCommission').textContent = fmt(totalComm);
  document.getElementById('finalPay').textContent        = fmt(totalFinalPay);

  var badge  = document.getElementById('modeBadge');
  var hint   = document.getElementById('calcHint');
  var tipBox = document.getElementById('tipBox');

  if (totalRev === 0) {
    badge.className   = 'mode-badge is-base';
    badge.textContent = s.noData;
    hint.textContent  = '';
    tipBox.classList.remove('is-visible');
  } else {
    var maxPossibleComm = totalComm;
    var maxPossibleBase = dailyBase * daysWorked;
    if (maxPossibleComm > maxPossibleBase) {
      badge.className   = 'mode-badge is-commission';
      badge.textContent = s.commission;
    } else {
      badge.className   = 'mode-badge is-base';
      badge.textContent = s.base;
    }
    hint.textContent = s.hintDaily(fmt(dailyBase), rate);
    tipBox.classList.remove('is-visible');
  }

  saveData();
}

/* =====================
   SAVE / LOAD
   ===================== */
function saveData() {
  var revenues = [];
  for (var i = 0; i < 7; i++) {
    var el = document.getElementById('revenue-' + i);
    revenues.push(el ? el.value : '');
  }
  var weekData = {
    baseSalary:     document.getElementById('baseSalary').value,
    commissionRate: document.getElementById('commissionRate').value,
    revenues:       revenues
  };
  localStorage.setItem(getWeekKey(weekOffset), JSON.stringify(weekData));
  localStorage.setItem('salary_settings', JSON.stringify({
    baseSalary:     weekData.baseSalary,
    commissionRate: weekData.commissionRate
  }));
}

function loadData() {
  var settings = JSON.parse(localStorage.getItem('salary_settings') || '{}');
  if (settings.baseSalary)     document.getElementById('baseSalary').value     = settings.baseSalary;
  if (settings.commissionRate) document.getElementById('commissionRate').value = settings.commissionRate;

  var weekData = JSON.parse(localStorage.getItem(getWeekKey(weekOffset)) || '{}');
  if (weekData.revenues) {
    for (var i = 0; i < weekData.revenues.length; i++) {
      var el = document.getElementById('revenue-' + i);
      if (el) el.value = weekData.revenues[i];
    }
  }
  recalc();
}

/* =====================
   CLEAR
   ===================== */
function clearWeek() {
  if (!confirm(STRINGS[lang].confirmClear)) return;
  for (var i = 0; i < 7; i++) {
    var el = document.getElementById('revenue-' + i);
    if (el) el.value = '';
  }
  localStorage.removeItem(getWeekKey(weekOffset));
  recalc();
}

/* =====================
   COPY
   ===================== */
function copyResult() {
  var s     = STRINGS[lang];
  var daily = parseFloat(document.getElementById('baseSalary').value) || 0;
  var rate  = parseFloat(document.getElementById('commissionRate').value) || 0;
  var start = getWeekStart(weekOffset);
  var end   = new Date(start);
  end.setDate(start.getDate() + 6);

  var lines = [
    s.copyHeader,
    s.copyPeriod(formatDate(start), formatDate(end)),
    s.copySettings(daily.toFixed(2), rate),
    ''
  ];

  for (var i = 0; i < 7; i++) {
    var el  = document.getElementById('revenue-' + i);
    var rev = el ? (parseFloat(el.value) || 0) : 0;
    if (rev > 0) {
      var comm   = rev * rate / 100;
      var dayPay = comm > daily ? comm : daily;
      var d = new Date(start);
      d.setDate(start.getDate() + i);
      lines.push(s.copyRow(STRINGS[lang].days[i], formatDate(d), fmt(rev), fmt(comm), fmt(dayPay)));
    }
  }

  lines.push('');
  lines.push(s.copyTotal(document.getElementById('totalRevenue').textContent));
  lines.push(s.copyComm(document.getElementById('totalCommission').textContent));
  lines.push(s.copyFinal(document.getElementById('finalPay').textContent));

  var btn = document.getElementById('btnCopy');
  navigator.clipboard.writeText(lines.join('\n')).then(function() {
    btn.textContent = s.copied;
    setTimeout(function() { btn.textContent = STRINGS[lang].btnCopy; }, 2000);
  });
}

/* =====================
   INIT
   ===================== */
(function() {
  document.getElementById('btnZh').classList.toggle('is-active', lang === 'zh');
  document.getElementById('btnEn').classList.toggle('is-active', lang === 'en');
  applyStrings();
  updateWeekLabel();
  buildDayRows();
  loadData();
})();

</script>
